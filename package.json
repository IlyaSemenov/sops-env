{
  "name": "sops-env",
  "version": "1.0.1",
  "description": "Print the env section of a SOPS-encrypted file as KEY=VALUE lines, optionally with base64-encoded values.",
  "keywords": [
    "cli",
    "dokku",
    "dotenv",
    "env",
    "secrets",
    "sops"
  ],
  "homepage": "https://github.com/IlyaSemenov/sops-env#readme",
  "bugs": "https://github.com/IlyaSemenov/sops-env/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/sops-env.git"
  },
  "bin": {
    "sops-env": "./dist/cli.mjs"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "release": "changesets-local",
    "release:check": "bun run build && bun run types && bun run test",
    "test": "bun test",
    "types": "bun check && bun check -p tests"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "changesets-local": "^1.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
